<% content_for :title, "対象料理設定の取り消し確認 | 給食リアクション" %>
<% content_for :head do %>
  <%= stylesheet_link_tag "https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400&display=swap", "data-turbo-track": "dynamic" %>
<% end %>

<main class="feedback-target-cancellation">
  <div class="feedback-target-cancellation-content mx-auto">
    <p class="feedback-target-cancellation-date">対象日：<time datetime="<%= @target_date.iso8601 %>"><%= @target_date.strftime("%Y年%-m月%-d日") %></time></p>

    <% category_labels = { "main_dish" => "主菜", "side_dish" => "副菜", "soup" => "汁物", "fruit_or_dessert" => "フルーツ・デザート" } %>
    <p class="feedback-target-cancellation-dish">対象料理：<%= @feedback_target.dish.name %>（<%= category_labels.fetch(@feedback_target.dish.category) %>）</p>
    <div class="feedback-target-cancellation-warning">
      <p>本日の対象料理とリアクション記録が削除されます。</p>
      <p>料理マスタは削除されません。</p>
      <p>この操作は元に戻せません。</p>
    </div>

    <div class="feedback-target-cancellation-actions">
      <%= link_to "キャンセル", new_feedback_target_path, class: "btn feedback-target-cancellation-button" %>
      <%= button_to "本日の設定を取り消す", feedback_target_path(@feedback_target), method: :delete,
        params: { displayed_target: @displayed_target }, class: "btn feedback-target-cancellation-button" %>
    </div>
  </div>
</main>
