<% content_for :title, "対象料理設定 | 給食リアクション" %>
<% if @feedback_target.persisted? %>
  <% content_for :head do %>
    <%= stylesheet_link_tag "https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400&display=swap", "data-turbo-track": "dynamic" %>
  <% end %>
<% end %>

<main class="feedback-target-setting <%= "feedback-target-setting--configured" if @feedback_target.persisted? %>">
  <div class="feedback-target-setting-content mx-auto">
    <% if @feedback_target.persisted? || @dishes.empty? %>
      <h2 class="text-center">設定フォーム</h2>
      <%= render "feedback_targets/flash" %>
    <% end %>

    <p class="feedback-target-setting-date">対象日：<time datetime="<%= @target_date.iso8601 %>"><%= @target_date.strftime("%Y年%-m月%-d日") %></time></p>

    <% category_labels = { "main_dish" => "主菜", "side_dish" => "副菜", "soup" => "汁物", "fruit_or_dessert" => "フルーツ・デザート" } %>
    <% if @feedback_target.persisted? %>
      <div class="feedback-target-setting-state">
        <p>本日のフィードバック対象料理は、既に設定済みです。</p>
        <p>対象料理：<%= @feedback_target.dish.name %>（<%= category_labels.fetch(@feedback_target.dish.category) %>）</p>
        <p>設定を変更したい場合は、「本日の設定を取り消す」を押してください。</p>
      </div>
      <%= link_to "本日の設定を取り消す", confirm_destroy_feedback_target_path(@feedback_target), class: "btn feedback-target-cancel-link" %>
    <% else %>
      <% if @feedback_target.errors.any? %>
        <div class="alert alert-danger" role="alert">
          <ul class="mb-0">
            <% @feedback_target.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <% if @dishes.empty? %>
        <div class="feedback-target-setting-state">
          <p>料理マスタが登録されていません。先に料理を登録してください</p>
          <%= link_to "料理マスタ登録", new_dish_path %>
        </div>
      <% else %>
        <h2 class="text-center">設定フォーム</h2>
        <%= render "feedback_targets/flash" %>

        <%= form_with model: @feedback_target do |form| %>
          <%= form.label :dish_id, "対象料理", class: "visually-hidden" %>
          <%= form.select :dish_id, @dishes.map { |dish| ["#{dish.name}（#{category_labels.fetch(dish.category)}）", dish.id] }, { prompt: "料理を選択してください" }, class: "form-select" %>

          <p class="feedback-target-setting-constraint">1日につきフィードバック対象料理は1品</p>

          <%= form.submit "設定", class: "btn w-100 feedback-target-setting-submit" %>
        <% end %>
      <% end %>
    <% end %>
  </div>
</main>
