<header class="shared-header shared-header--after-login <%= center_user? ? "shared-header--center" : "shared-header--kindergarten" %>">
  <% if kindergarten_user? %>
    <nav aria-label="幼稚園用ナビゲーション">
      <div class="shared-header-row">
        <%= render "shared/logo" %>
        <div class="shared-header-links">
          <%= link_to "入力・編集", new_reaction_path, class: "nav-link" %>
          <%= link_to "集計結果", reactions_path, class: "nav-link" %>
          <%= link_to "ログアウト", kindergarten_logout_path, class: "nav-link d-none d-md-block", data: { turbo_method: :delete } %>

          <div class="dropdown d-md-none">
            <button class="btn shared-kindergarten-menu-button d-flex align-items-center justify-content-center" type="button" id="kindergarten-menu" data-bs-toggle="dropdown" data-bs-offset="7,7" aria-expanded="false" aria-controls="kindergarten-menu-items" aria-label="メニューを開く">
              <%= image_tag "menu.svg", alt: "", width: 20, height: 14 %>
            </button>
            <ul class="dropdown-menu dropdown-menu-end" id="kindergarten-menu-items" aria-labelledby="kindergarten-menu">
              <li><%= link_to "ログアウト", kindergarten_logout_path, class: "dropdown-item", data: { turbo_method: :delete } %></li>
            </ul>
          </div>
        </div>
      </div>
      <span class="shared-header-name"><%= current_user.kindergarten.name %></span>
    </nav>
  <% elsif center_user? %>
    <nav aria-label="給食センター用ナビゲーション">
      <div class="shared-header-row">
        <%= render "shared/logo" %>
        <div class="shared-header-links">
          <%= link_to "当日集計結果", center_reaction_results_path, class: "nav-link" %>
          <%= link_to "対象料理設定", new_feedback_target_path, class: "nav-link" %>
          <%= link_to "料理マスタ登録", new_dish_path, class: "nav-link" %>
          <%= link_to "ログアウト", center_logout_path, class: "nav-link", data: { turbo_method: :delete } %>
        </div>
      </div>
      <span class="shared-header-name">Philia給食センター</span>
    </nav>
  <% end %>
</header>
