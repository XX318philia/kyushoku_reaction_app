<header class="shared-header shared-header--before-login <%= "shared-header--home" if controller_name == "home" && action_name == "index" %>">
  <% if [kindergarten_login_path, center_login_path].include?(request.path) %>
    <%= link_to root_path, class: "shared-logo-link", aria: { label: "TOPページへ戻る" } do %>
      <%= render "shared/logo" %>
    <% end %>
  <% else %>
    <%= render "shared/logo" %>
  <% end %>
  <% if controller_name == "home" && action_name == "index" %>
    <nav class="shared-login-links" aria-label="ログイン先">
      <%= link_to kindergarten_login_path, class: "shared-login-link shared-login-link--kindergarten" do %>
        <span>幼稚園の先生</span><span>はこちら</span>
      <% end %>
      <%= link_to center_login_path, class: "shared-login-link shared-login-link--center" do %>
        <span>給食センター</span><span>の方はこちら</span>
      <% end %>
    </nav>
  <% end %>
</header>
